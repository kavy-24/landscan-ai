# ---------------------------------------------------------------------------
# BhoomiScan AI — backend environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# Comma separated list of allowed frontend origins (TanStack Start dev server)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/bhoomiscan

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# OCR (Tesseract.js)
TESSERACT_LANGS=eng
TESSERACT_CACHE_DIR=.tesseract-cache

# Google Gemini
# Leave empty to fall back to the deterministic rule-based extractor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Validation thresholds (percent)
LOW_CONFIDENCE_FIELD_THRESHOLD=78
LOW_CONFIDENCE_RECORD_THRESHOLD=80
AUTO_VERIFY_THRESHOLD=95

# Seed admin (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin.meera@gov.in
SEED_ADMIN_PASSWORD=demo1234
